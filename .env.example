NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production
OPENAI_API_KEY=
CREDENTIALS_ENCRYPTION_KEY=
META_APP_SECRET=
WHATSAPP_APP_SECRET=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta channel env fallbacks (prefer per-tenant tokens in Settings → Channels)
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Media providers — must NOT be "mock" in production
OCR_PROVIDER=google
OCR_API_KEY=
SPEECH_PROVIDER=openai
SPEECH_API_KEY=

# Escape hatch for staging only (never in true production)
ALLOW_MOCK_PROVIDERS=false

# Couriers (optional until live booking is enabled)
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
REDX_API_KEY=
STEADFAST_API_KEY=
DELIVERY_TIGER_API_KEY=

# Billing / cron
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
